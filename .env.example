# Required for continuous inference
ROBOFLOW_API_KEY=your_roboflow_api_key
ROBOFLOW_API_URL=http://your-inference-server:9001
ROBOFLOW_WORKSPACE=your_roboflow_workspace
ROBOFLOW_WORKFLOW=your_roboflow_workflow
ROBOFLOW_IMAGE_INPUT=image
ROBOFLOW_STREAM_OUTPUT=output_image
ROBOFLOW_DATA_OUTPUTS=identified_cats,raw_cat_predictions,vision_events_message,vision_events_event_id

# WebRTC video session
INFERENCE_DECLARED_FPS=24
INFERENCE_PROCESSING_TIMEOUT=3600
INFERENCE_JPEG_QUALITY=85
PYTHON_COMMAND=.venv/bin/python
# Times use the Raspberry Pi's local timezone
INFERENCE_SCHEDULE_FILE=data/inference-schedule.json

# Persistent cat detection history
DETECTION_LOG_FILE=data/detection-log.jsonl
# A cat must remain absent this long before a "left" event is saved
DETECTION_LOG_COOLDOWN_MS=1000

# Event-centered MP4 clips (5 seconds before + 5 seconds after by default)
DETECTION_CLIPS_ENABLED=true
DETECTION_CLIP_DIRECTORY=data/clips
DETECTION_CLIP_DURATION_SECONDS=10
FFMPEG_COMMAND=ffmpeg

# Raspberry Pi camera process
CAMERA_COMMAND=rpicam-vid
CAMERA_WIDTH=1280
CAMERA_HEIGHT=720
CAMERA_FPS=24
CAMERA_QUALITY=80

# Optional JSON array of additional rpicam-vid arguments
# CAMERA_EXTRA_ARGS=["--rotation","180"]

# Web server
HOST=0.0.0.0
PORT=3000

# Local development without a Pi camera
# MOCK_CAMERA_IMAGE=public/og.png
